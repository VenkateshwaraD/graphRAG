# ---- LLM (provider-agnostic; default = OpenAI-compatible gateway) ----
LLM_PROVIDER=openai_compat          # openai_compat | anthropic | ollama | fake
LLM_MODEL=global.anthropic.claude-sonnet-4-6
LLM_ROUTER_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_BASE_URL=https://llmgw-wp.tekstac.com
LLM_API_KEY=                        # falls back to CLAUDE_API_KEY / OPENAI_API_KEY env vars
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1024

# ---- Embeddings (shared for chunk indexing AND query embedding) ----
EMBEDDING_PROVIDER=sentence_transformers   # sentence_transformers | openai | voyage
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384                         # must match the model; auto-verified at startup
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---- GraphRAG ----
GRAPHRAG_ROOT=data/graphrag       # settings.yaml + input/ + output/ live here
GRAPHRAG_MAX_GLEANINGS=1
GRAPHRAG_COMMUNITY_LEVEL=0        # max level used by global search
TRAVERSE_K_HOPS=2

# ---- Storage ----
DATABASE_URL=sqlite:///data/app.db
LANCEDB_URI=data/lancedb
UPLOAD_DIR=data/uploads

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
# Break-glass platform-admin key (required, min 16 chars, no defaults).
# Per-user keys are minted via POST /users and stored hashed.
API_KEY=
# Local dev only: run unauthenticated when API_KEY is unset.
# ALLOW_INSECURE_AUTH=true
# Failed-key attempts allowed per client IP per minute before 429.
# AUTH_FAIL_LIMIT_PER_MINUTE=10
